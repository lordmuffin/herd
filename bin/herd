#!/usr/bin/env bash
# herd — fan out coding agents into fresh git worktrees, one Herdr workspace each.
#
#   herd [opts] <branch> <prompt> [<branch> <prompt> ...]
#   herd [opts] [-f Tasks.herd]       # one "branch: prompt" per line, # comments ok; with no
#                                     # tasks given, reads Tasks.herd from the repo root
#   herd ls                           # agents + their status
#   herd personas [<name>]            # list personas, or print one as a ready-to-paste prompt
#   herd rm [-f file] <branch|name>...        # remove worktree, workspace and local branch
#   herd done [-F] [-f file] <branch|name>... # after merge: check PR merged + agent idle + tree
#                                     # clean, then rm and delete the remote branch (-F skips checks)
#                                     # -f takes the same file as spawning (or "-" for stdin); only
#                                     # the branch before the first ":" is used, so one file can
#                                     # start a batch and later close it. done with no targets
#                                     # reads Tasks.herd too; rm never does, it must be named
#
# opts:
#   -r <repo>     source checkout (default: git toplevel of $PWD)
#   -b <ref>      base ref (default: origin/main, fetched first)
#   -k <kind>     agent kind (default: claude)
#   -P <persona>  persona prepended to every prompt (name, or a path to a .md file)
#   -p <ws-id>    parent workspace to group under (default: the one labelled like the repo)
#   -m <machine>  saved herdr machine (remote paths go under ~/git/wt)
#   -w            wait for every agent to finish, then print a summary
#   -n            dry run: print each task's branch, agent name and persona, start nothing
#   -- <args>     extra args passed to the agent (e.g. -- --model sonnet)
#
# Branch names double as agent names: fix/foo-bar -> agent "fix-foo-bar".
#
# A task line may name its own persona, which overrides -P:
#   fix/foo @engineer: Fix X. Run make test, open a PR labelled review-me.
# Personas are read from $HERD_PERSONA_DIR, <repo>/.herd/personas, ~/.config/herd/personas,
# then the ones shipped with herd. "@none" runs the prompt bare.
# A name that matches no file exactly falls back to a case-insensitive fuzzy match (-P kai).
set -euo pipefail

repo="" base="origin/main" kind="claude" machine="" parent="" parent_ws="" wait=0 force=0 file="" agent_args=() targets=()
persona="" dry=0

die() { echo "herd: $*" >&2; exit 1; }
h() { if [[ -n $machine ]]; then herdr --machine "$machine" "$@"; else herdr "$@"; fi; }
agent_name() { local n; n=$(tr 'A-Z/._' 'a-z---' <<<"$1" | tr -cd 'a-z0-9_-'); n=${n#[-_0-9]}; echo "${n:0:32}"; }

# The comment block at the top of this file, minus its leading "# ".
usage() { awk 'NR > 1 && /^#/ { sub(/^#( |$)/, ""); print; next } NR > 1 { exit }' "$0"; }

# Where this script really lives, following a `make link` symlink.
script_dir() {
  local src=$1 dir
  while [[ -L $src ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src"); [[ $src == /* ]] || src="$dir/$src"
  done
  (cd -P "$(dirname "$src")" && pwd)
}

# Persona search path, most specific first. $repo may not be known yet; that entry is skipped.
persona_dirs() {
  local d; d=$(script_dir "${BASH_SOURCE[0]}")
  [[ -n ${HERD_PERSONA_DIR:-} ]] && echo "$HERD_PERSONA_DIR"
  [[ -n ${repo:-} ]] && echo "$repo/.herd/personas"
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/herd/personas"
  echo "$d/../personas"             # dev checkout: bin/herd next to personas/
  echo "$d/../share/herd/personas"  # make install / package
}

# Resolves a persona name (or a path to a .md file) to a readable file.
persona_file() {
  local n=$1 d
  if [[ $n == *.md || $n == */* ]]; then
    [[ -f $n ]] || die "no persona file: $n"
    echo "$n"; return
  fi
  while IFS= read -r d; do
    [[ -f "$d/$n.md" ]] && { echo "$d/$n.md"; return; }
  done < <(persona_dirs)
  persona_fuzzy "$n"
}

# Last resort for persona_file: a case-insensitive match on the file name. A name that is the whole
# name or its first word ("kai" -> "Kai - The Kaizen Engineer") beats one that merely contains it
# ("kai" also sits inside "Kairos"). Must resolve to exactly one persona.
persona_fuzzy() {
  local q d f b all="" hits tier
  q=$(tr 'A-Z' 'a-z' <<<"$1")
  while IFS= read -r d; do
    [[ -d $d ]] || continue
    for f in "$d"/*.md; do
      [[ -f $f ]] || continue
      b=$(basename "$f" .md)
      all+=$(printf '%s\t%s\t%s' "$(tr 'A-Z' 'a-z' <<<"$b")" "$b" "$f")$'\n'
    done
  done < <(persona_dirs)
  for tier in first any; do
    hits=$(awk -F'\t' -v q="$q" -v t="$tier" '
      !seen[$2]++ && (t == "any" ? index($1, q) : ($1 == q || index($1, q " ") == 1 || index($1, q "-") == 1)) { print }' <<<"$all")
    [[ -n $hits ]] || continue
    if [[ $(wc -l <<<"$hits") -eq 1 ]]; then cut -f3 <<<"$hits"; return; fi
    die "persona '$1' is ambiguous: $(cut -f2 <<<"$hits" | paste -sd, - | sed 's/,/, /g')"
  done
  die "unknown persona: $1 (herd personas lists them)"
}

# Persona text, a rule, then the task — so the agent reads the role before the job.
compose() {
  local p=$1 f
  if [[ -z $p || $p == none ]]; then printf '%s' "$2"; return; fi
  f=$(persona_file "$p")   # set -e: an unknown persona stops the run here
  printf '%s\n\n---\n\n# Task\n\n%s\n' "$(cat "$f")" "$2"
}

# Splits a task key into branch and persona: "fix/foo @engineer" -> fix/foo, engineer.
# Sets task_branch and task_persona; an unqualified key keeps the run-wide -P.
split_key() {
  local key=$1
  task_branch=$key task_persona=$persona
  if [[ $key =~ ^[[:space:]]*([^[:space:]@]+)[[:space:]]*@([A-Za-z0-9._/-]+)[[:space:]]*$ ]]; then
    task_branch=${BASH_REMATCH[1]} task_persona=${BASH_REMATCH[2]}
  fi
  task_branch=$(tr -d '[:space:]' <<<"$task_branch")
}

cmd_personas() {
  if [[ $# -gt 0 ]]; then compose "$1" "<your task here>"; return; fi
  local d f n desc
  { while IFS= read -r d; do
      [[ -d $d ]] || continue
      for f in "$d"/*.md; do
        [[ -f $f ]] || continue
        n=$(basename "$f" .md)
        # The "> ..." line under the title doubles as the one-line summary.
        desc=$(sed -n 's/^> //p' "$f" | head -1)
        printf '%s\t%s\t%s\n' "$n" "${desc:--}" "$f"
      done
    done < <(persona_dirs); } | awk -F'\t' '!seen[$1]++' | column -t -s $'\t'
}

# Prints the repo root's Tasks.herd if there is one, and says so on stderr. With -m, -r is a path
# on the remote, so the file is looked for in the local checkout.
default_file() {
  local root=$repo
  [[ -z $machine ]] || root=""
  [[ -n $root ]] || root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  if [[ -f $root/Tasks.herd ]]; then
    echo "herd: using $root/Tasks.herd" >&2
    echo "$root/Tasks.herd"
  fi
}

# Appends the branch of each "branch[ @persona][: prompt]" line in $1 ("-" = stdin) to targets.
read_targets() {
  local line
  [[ $1 == - || -f $1 ]] || die "no such file: $1"
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    split_key "${line%%:*}"
    [[ -n $task_branch ]] && targets+=("$task_branch")
  done < <(if [[ $1 == - ]]; then cat; else cat "$1"; fi)
}

cmd_ls() {
  h agent list | jq -r '.result.agents[] | [.name // "-", .agent, .agent_status, .cwd] | @tsv' | column -t -s $'\t'
}

# Sets ws, path, branch for a linked worktree matching a branch or agent name; fails if none.
find_wt() {
  ws="" path="" branch=""
  [[ -n ${wt_list:-} ]] || wt_list=$(h worktree list --cwd "$repo" 2>/dev/null || h worktree list)
  read -r ws path branch < <(jq -r --arg t "$1" --arg n "$(agent_name "$1")" '
    .result.worktrees[] | select(.is_linked_worktree)
    | select(.branch == $t or (.path | endswith("/" + $n)))
    | [.open_workspace_id // "-", .path, .branch] | @tsv' <<<"$wt_list" | head -1) || true
  [[ -n $path ]] || { echo "herd: no worktree for $1" >&2; return 1; }
}

remove_wt() {
  if [[ $ws != "-" ]]; then
    h worktree remove --workspace "$ws" --force >/dev/null
  else
    git -C "$repo" worktree remove --force "$path"
  fi
  git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
  echo "removed $branch ($path)"
}

cmd_rm() {
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  for target in "$@"; do find_wt "$target" && remove_wt; done
}

# forgejo-cli's token store: XDG data dir on Linux, Application Support on macOS.
forgejo_keys() {
  local c
  # macOS: the directories crate names the dir <qualifier>.<org>.<app>, which with
  # neither qualifier nor org set doubles the app name.
  for c in "${XDG_DATA_HOME:-$HOME/.local/share}/forgejo-cli/keys.json" \
           "$HOME/Library/Application Support/forgejo-cli.forgejo-cli/keys.json" \
           "$HOME/Library/Application Support/forgejo-cli/keys.json"; do
    [[ -f $c ]] && { echo "$c"; return; }
  done
  die "no forgejo-cli keys.json (run: fj auth login, or fj auth add-token)"
}

# Forgejo API call authenticated with fj's stored token for the origin host.
forgejo() {
  local url host keys tok
  keys=$(forgejo_keys)
  url=$(git -C "$repo" remote get-url origin)
  host=$(sed -E 's#^[a-z+]+://([^@/]+@)?([^:/]+).*#\2#; s#^[^@]+@([^:]+):.*#\1#' <<<"$url")
  host=$(jq -r --arg h "$host" '.aliases[$h] // $h' "$keys")
  tok=$(jq -r --arg h "$host" '.hosts[$h].token // empty' "$keys")
  [[ -n $tok ]] || die "no fj token for $host (run: fj auth login, or fj auth add-token)"
  repo_slug=$(sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#' <<<"$url")
  curl -sf -H "Authorization: token $tok" "https://$host/api/v1/repos/$repo_slug/$1"
}

# Clean up a stream only once its PR is merged: agent idle, worktree clean, then worktree,
# workspace, local and remote branch all go.
cmd_done() {
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  local into=${base#origin/} pr status dirty
  for target in "$@"; do
    find_wt "$target" || continue
    if ! pr=$(forgejo "pulls/$into/$branch"); then
      echo "herd: $branch has no PR into $into — not removing (use herd rm to discard)" >&2; continue
    fi
    if [[ $(jq -r .merged <<<"$pr") != true ]]; then
      echo "herd: $branch PR #$(jq -r .number <<<"$pr") is $(jq -r .state <<<"$pr"), not merged — skipping" >&2
      ((force)) || continue
    fi
    # A PR merged before the agent's last push leaves commits only on this branch.
    git -C "$repo" fetch -q origin "$into"
    local unmerged; unmerged=$(git -C "$path" log --oneline "origin/$into..HEAD")
    if [[ -n $unmerged ]]; then
      echo "herd: $branch has commits not in $into — skipping (open a follow-up PR):" >&2
      sed 's/^/    /' <<<"$unmerged" >&2; ((force)) || continue
    fi
    status=$(h agent list | jq -r --arg p "$path" '.result.agents[] | select(.cwd == $p) | .agent_status' | head -1)
    if [[ $status == working || $status == blocked ]]; then
      echo "herd: agent in $branch is $status — skipping" >&2; ((force)) || continue
    fi
    dirty=$(git -C "$path" status --porcelain)
    if [[ -n $dirty ]]; then
      echo "herd: $branch has uncommitted changes — skipping:" >&2; sed 's/^/    /' <<<"$dirty" >&2
      ((force)) || continue
    fi
    remove_wt
    if git -C "$repo" ls-remote --exit-code --heads origin "$branch" >/dev/null; then
      git -C "$repo" push -q origin --delete "$branch" && echo "deleted origin/$branch"
    fi
    echo "done: PR #$(jq -r .number <<<"$pr") $(jq -r .html_url <<<"$pr")"
  done
}

# Herdr nests a worktree under the workspace it is created from. Prefer the one named after the
# repo, so worktrees don't land under some other workspace (e.g. a K9S one) that happens to sit in
# the repo root.
pick_parent() {
  [[ -n $parent ]] && { echo "$parent"; return; }
  local name ws
  name=$(basename "$repo")
  ws=$(h workspace list | jq -r --arg n "$name" --arg r "$repo" '
    [.result.workspaces[] | select(.label == $n)]
    | (map(select(.worktree.repo_root == $r and (.worktree.is_linked_worktree | not))) + .)
    | .[].workspace_id' | awk '!seen[$0]++')
  for w in $ws; do
    if h pane list --workspace "$w" | jq -e --arg r "$repo" \
        'any(.result.panes[]; .cwd == $r or (.cwd | startswith($r + "/")))' >/dev/null; then
      echo "$w"; return
    fi
  done
  if [[ -n ${HERDR_WORKSPACE_ID:-} && -z $machine && $PWD == "$repo"* ]]; then
    echo "$HERDR_WORKSPACE_ID"
  fi
}

spawn() {
  local branch=$1 prompt=$2 name path out pane
  prompt=$(compose "$3" "$prompt")
  name=$(agent_name "$branch")
  # shellcheck disable=SC2088  # herdr expands ~ on the remote host
  if [[ -n $machine ]]; then path="~/git/wt/$(basename "$repo")/$name"
  else path="$HOME/git/wt/$(basename "$repo")/$name"; fi

  local src=(--cwd "$repo")
  [[ -n $parent_ws ]] && src=(--workspace "$parent_ws")
  out=$(h worktree create "${src[@]}" --branch "$branch" --base "$base" \
          --path "$path" --label "$name" --no-focus) || die "worktree create failed for $branch"
  pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")

  h agent start "$name" --kind "$kind" --pane "$pane" --timeout 90000 -- "${agent_args[@]}" >/dev/null \
    || die "agent start failed for $name (pane $pane) — inspect with: herdr agent read $name"
  # Wait only until the turn has visibly started, so a later `agent wait` can't see the pre-prompt idle.
  h agent prompt "$name" "$prompt" --wait --until working --until blocked --until "done" --timeout 30000 >/dev/null \
    || die "prompt not picked up by $name — inspect with: herdr agent read $name"
  echo "started $name  ($branch -> $path, pane $pane)"
  names+=("$name")
}

case ${1:-} in
  ls) shift; cmd_ls; exit ;;
  personas) shift; [[ $# -le 1 ]] || die "personas takes at most one name"
      repo=$(git rev-parse --show-toplevel 2>/dev/null || true); cmd_personas "$@"; exit ;;
  "done") shift; while getopts "r:b:Ff:" o; do case $o in r) repo=$OPTARG;; b) base=$OPTARG;; F) force=1;; f) file=$OPTARG;; *) exit 2;; esac; done
      shift $((OPTIND-1)); targets=("$@"); [[ -n $file || $# -gt 0 ]] || file=$(default_file)
      [[ -z $file ]] || read_targets "$file"
      [[ ${#targets[@]} -gt 0 ]] || die "done needs a branch or agent name (or -f file, or a Tasks.herd)"; cmd_done "${targets[@]}"; exit ;;
  rm) shift; while getopts "r:m:f:" o; do case $o in r) repo=$OPTARG;; m) machine=$OPTARG;; f) file=$OPTARG;; *) exit 2;; esac; done
      shift $((OPTIND-1)); targets=("$@"); [[ -z $file ]] || read_targets "$file"
      [[ ${#targets[@]} -gt 0 ]] || die "rm needs a branch or agent name (or -f file)"; cmd_rm "${targets[@]}"; exit ;;
esac

while getopts "r:b:k:m:p:P:f:wnh" o; do
  case $o in
    r) repo=$OPTARG ;; b) base=$OPTARG ;; k) kind=$OPTARG ;; m) machine=$OPTARG ;;
    p) parent=$OPTARG ;; P) persona=$OPTARG ;; f) file=$OPTARG ;; w) wait=1 ;; n) dry=1 ;;
    h) usage; exit ;; *) exit 2 ;;
  esac
done
shift $((OPTIND-1))

tasks=()
while [[ $# -gt 0 && $1 != "--" ]]; do
  [[ $# -ge 2 ]] || die "expected <branch> <prompt> pairs"
  split_key "$1"; tasks+=("$task_branch" "$2" "$task_persona"); shift 2
done
[[ ${1:-} == "--" ]] && { shift; agent_args=("$@"); }

[[ -n $file || ${#tasks[@]} -gt 0 ]] || file=$(default_file)
if [[ -n $file ]]; then
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line == *:* ]] || die "bad line (want 'branch: prompt'): $line"
    split_key "${line%%:*}"
    tasks+=("$task_branch" "$(sed 's/^[[:space:]]*//' <<<"${line#*:}")" "$task_persona")
  done <"$file"
fi
[[ ${#tasks[@]} -gt 0 ]] || { usage; exit 2; }

if [[ -z $machine ]]; then
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  repo=$(cd "$repo" && git rev-parse --show-toplevel)
  [[ $base == origin/* && $dry -eq 0 ]] && git -C "$repo" fetch -q origin "${base#origin/}"
else
  [[ -n $repo ]] || die "-m needs -r <remote repo path>"
fi

# Resolve every persona before spawning anything, so a typo can't leave a half-run fan-out.
for ((i = 2; i < ${#tasks[@]}; i += 3)); do
  [[ -z ${tasks[i]} || ${tasks[i]} == none ]] || persona_file "${tasks[i]}" >/dev/null
done

if ((dry)); then
  for ((i = 0; i < ${#tasks[@]}; i += 3)); do
    printf '%s\t%s\t%s\t%s\n' "${tasks[i]}" "$(agent_name "${tasks[i]}")" "${tasks[i+2]:-none}" \
      "$(head -c 60 <<<"${tasks[i+1]}")..."
  done | column -t -s $'\t'
  exit
fi

parent_ws=$(pick_parent)
[[ -n $parent_ws ]] && echo "grouping under workspace $parent_ws"
names=()
for ((i = 0; i < ${#tasks[@]}; i += 3)); do spawn "${tasks[i]}" "${tasks[i+1]}" "${tasks[i+2]}"; done

if ((wait)); then
  echo "waiting for ${#names[@]} agent(s)..."
  for n in "${names[@]}"; do
    s=$(h agent wait "$n" 2>/dev/null | jq -r '.result.agent.agent_status' || echo "?")
    echo "  $n: $s"
  done
fi
