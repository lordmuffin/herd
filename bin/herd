#!/usr/bin/env bash
# herd — fan out coding agents into fresh git worktrees, one Herdr workspace each.
#
#   herd [opts] <branch> <prompt> [<branch> <prompt> ...]
#   herd [opts] [-f Tasks.herd]       # one "branch: prompt" per line, # comments ok; with no
#                                     # tasks given, reads Tasks.herd from the repo root
#   herd plan [opts] [-v cmd] [-W min] <branch> <plan.md|-|text>
#                                     # run one complete plan as a chain of stages in one worktree:
#                                     # a planner turn splits it into .herd/run/stages.md (skipped
#                                     # if the plan already has "## Stage N: title" headings), then
#                                     # each stage gets a fresh session, hands off through
#                                     # .herd/run/PROGRESS.md and must pass its gate (handoff written,
#                                     # tree committed, its "verify:" command or -v passing) before
#                                     # the next starts; one fix-up turn on a miss. The last stage
#                                     # pushes and opens the PR. -P sets the stage persona (default
#                                     # engineer); -n stops once the stages are written. A turn that
#                                     # ends with background shells or monitors still running is
#                                     # waited out before the gate, up to -W minutes (default 60).
#                                     # A "STOPPED: reason" line in PROGRESS.md stops the run at once
#   herd plan -R <branch>             # resume a plan stopped by a block, a failed gate or ^C
#   herd draft [-o file] [-F] <goal|file|->
#                                     # turn a goal into a task file: a read-only dispatcher agent
#                                     # reads the repo and writes one "branch @persona: prompt" line
#                                     # per parallel task; herd checks every line before it saves
#                                     # Tasks.herd (or -o file, "-" for stdout; -F overwrites)
#   herd ls                           # agents + their status
#   herd personas [<name>]            # list personas, or print one as a ready-to-paste prompt
#   herd rm [-f file] <branch|name>...        # remove worktree, workspace and local branch
#   herd done [-F] [-f file] <branch|name>... # after merge: check PR merged + agent idle + tree
#                                     # clean, then rm and delete the remote branch (-F skips checks)
#                                     # -f takes the same file as spawning (or "-" for stdin); only
#                                     # the branch before the first ":" is used, so one file can
#                                     # start a batch and later close it. done with no targets
#                                     # reads Tasks.herd too; rm never does, it must be named
#
# opts:
#   -r <repo>     source checkout (default: git toplevel of $PWD)
#   -b <ref>      base ref (default: origin/main, fetched first)
#   -k <kind>     agent kind (default: claude)
#   -P <persona>  persona prepended to every prompt (name, or a path to a .md file)
#   -p <ws-id>    parent workspace to group under (default: the one labelled like the repo)
#   -m <machine>  saved herdr machine (remote paths go under ~/git/wt)
#   -w            wait for every agent to finish, then print a summary
#   -n            dry run: print each task's branch, agent name and persona, start nothing
#   -- <args>     extra args passed to the agent (e.g. -- --model sonnet)
#
# Branch names double as agent names: fix/foo-bar -> agent "fix-foo-bar".
#
# A task line may name its own persona, which overrides -P:
#   fix/foo @engineer: Fix X. Run make test, open a PR labelled review-me.
# Personas are read from $HERD_PERSONA_DIR, <repo>/.herd/personas, ~/.config/herd/personas,
# then the ones shipped with herd. "@none" runs the prompt bare.
# A name that matches no file exactly falls back to a case-insensitive fuzzy match (-P kai).
set -euo pipefail

repo="" base="origin/main" kind="claude" machine="" parent="" parent_ws="" wait=0 force=0 file="" agent_args=() targets=()
persona="" dry=0 bg_wait=60 bg_poll=${HERD_BG_POLL:-30}

die() { echo "herd: $*" >&2; exit 1; }
h() { if [[ -n $machine ]]; then herdr --machine "$machine" "$@"; else herdr "$@"; fi; }
agent_name() { local n; n=$(tr 'A-Z/._' 'a-z---' <<<"$1" | tr -cd 'a-z0-9_-'); n=${n#[-_0-9]}; echo "${n:0:32}"; }

# The comment block at the top of this file, minus its leading "# ".
usage() { awk 'NR > 1 && /^#/ { sub(/^#( |$)/, ""); print; next } NR > 1 { exit }' "$0"; }

# Where this script really lives, following a `make link` symlink.
script_dir() {
  local src=$1 dir
  while [[ -L $src ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src"); [[ $src == /* ]] || src="$dir/$src"
  done
  (cd -P "$(dirname "$src")" && pwd)
}

# Persona search path, most specific first. $repo may not be known yet; that entry is skipped.
persona_dirs() {
  local d; d=$(script_dir "${BASH_SOURCE[0]}")
  [[ -n ${HERD_PERSONA_DIR:-} ]] && echo "$HERD_PERSONA_DIR"
  [[ -n ${repo:-} ]] && echo "$repo/.herd/personas"
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/herd/personas"
  echo "$d/../personas"             # dev checkout: bin/herd next to personas/
  echo "$d/../share/herd/personas"  # make install / package
}

# Resolves a persona name (or a path to a .md file) to a readable file.
persona_file() {
  local n=$1 d
  if [[ $n == *.md || $n == */* ]]; then
    [[ -f $n ]] || die "no persona file: $n"
    echo "$n"; return
  fi
  while IFS= read -r d; do
    [[ -f "$d/$n.md" ]] && { echo "$d/$n.md"; return; }
  done < <(persona_dirs)
  persona_fuzzy "$n"
}

# Last resort for persona_file: a case-insensitive match on the file name. A name that is the whole
# name or its first word ("kai" -> "Kai - The Kaizen Engineer") beats one that merely contains it
# ("kai" also sits inside "Kairos"). Must resolve to exactly one persona.
persona_fuzzy() {
  local q d f b all="" hits tier
  q=$(tr 'A-Z' 'a-z' <<<"$1")
  while IFS= read -r d; do
    [[ -d $d ]] || continue
    for f in "$d"/*.md; do
      [[ -f $f ]] || continue
      b=$(basename "$f" .md)
      all+=$(printf '%s\t%s\t%s' "$(tr 'A-Z' 'a-z' <<<"$b")" "$b" "$f")$'\n'
    done
  done < <(persona_dirs)
  for tier in first any; do
    hits=$(awk -F'\t' -v q="$q" -v t="$tier" '
      !seen[$2]++ && (t == "any" ? index($1, q) : ($1 == q || index($1, q " ") == 1 || index($1, q "-") == 1)) { print }' <<<"$all")
    [[ -n $hits ]] || continue
    if [[ $(wc -l <<<"$hits") -eq 1 ]]; then cut -f3 <<<"$hits"; return; fi
    die "persona '$1' is ambiguous: $(cut -f2 <<<"$hits" | paste -sd, - | sed 's/,/, /g')"
  done
  die "unknown persona: $1 (herd personas lists them)"
}

# Persona text, a rule, then the task — so the agent reads the role before the job.
compose() {
  local p=$1 f
  if [[ -z $p || $p == none ]]; then printf '%s' "$2"; return; fi
  f=$(persona_file "$p")   # set -e: an unknown persona stops the run here
  printf '%s\n\n---\n\n# Task\n\n%s\n' "$(cat "$f")" "$2"
}

# Splits a task key into branch and persona: "fix/foo @engineer" -> fix/foo, engineer.
# Sets task_branch and task_persona; an unqualified key keeps the run-wide -P.
split_key() {
  local key=$1
  task_branch=$key task_persona=$persona
  if [[ $key =~ ^[[:space:]]*([^[:space:]@]+)[[:space:]]*@([A-Za-z0-9._/-]+)[[:space:]]*$ ]]; then
    task_branch=${BASH_REMATCH[1]} task_persona=${BASH_REMATCH[2]}
  fi
  task_branch=$(tr -d '[:space:]' <<<"$task_branch")
}

cmd_personas() {
  if [[ $# -gt 0 ]]; then compose "$1" "<your task here>"; return; fi
  local d f n desc
  { while IFS= read -r d; do
      [[ -d $d ]] || continue
      for f in "$d"/*.md; do
        [[ -f $f ]] || continue
        n=$(basename "$f" .md)
        # The "> ..." line under the title doubles as the one-line summary.
        desc=$(sed -n 's/^> //p' "$f" | head -1)
        printf '%s\t%s\t%s\n' "$n" "${desc:--}" "$f"
      done
    done < <(persona_dirs); } | awk -F'\t' '!seen[$1]++' | column -t -s $'\t'
}

# Prints the repo root's Tasks.herd if there is one, and says so on stderr. With -m, -r is a path
# on the remote, so the file is looked for in the local checkout.
default_file() {
  local root=$repo
  [[ -z $machine ]] || root=""
  [[ -n $root ]] || root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  if [[ -f $root/Tasks.herd ]]; then
    echo "herd: using $root/Tasks.herd" >&2
    echo "$root/Tasks.herd"
  fi
}

# Appends the branch of each "branch[ @persona][: prompt]" line in $1 ("-" = stdin) to targets.
read_targets() {
  local line
  [[ $1 == - || -f $1 ]] || die "no such file: $1"
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    split_key "${line%%:*}"
    [[ -n $task_branch ]] && targets+=("$task_branch")
  done < <(if [[ $1 == - ]]; then cat; else cat "$1"; fi)
}

cmd_ls() {
  h agent list | jq -r '.result.agents[] | [.name // "-", .agent, .agent_status, .cwd] | @tsv' | column -t -s $'\t'
}

# Sets ws, path, branch for a linked worktree matching a branch or agent name; fails if none.
find_wt() {
  ws="" path="" branch=""
  [[ -n ${wt_list:-} ]] || wt_list=$(h worktree list --cwd "$repo" 2>/dev/null || h worktree list)
  read -r ws path branch < <(jq -r --arg t "$1" --arg n "$(agent_name "$1")" '
    .result.worktrees[] | select(.is_linked_worktree)
    | select(.branch == $t or (.path | endswith("/" + $n)))
    | [.open_workspace_id // "-", .path, .branch] | @tsv' <<<"$wt_list" | head -1) || true
  [[ -n $path ]] || { echo "herd: no worktree for $1" >&2; return 1; }
}

remove_wt() {
  if [[ $ws != "-" ]]; then
    h worktree remove --workspace "$ws" --force >/dev/null
  else
    git -C "$repo" worktree remove --force "$path"
  fi
  git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
  echo "removed $branch ($path)"
}

cmd_rm() {
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  for target in "$@"; do find_wt "$target" && remove_wt; done
}

# forgejo-cli's token store: XDG data dir on Linux, Application Support on macOS.
forgejo_keys() {
  local c
  # macOS: the directories crate names the dir <qualifier>.<org>.<app>, which with
  # neither qualifier nor org set doubles the app name.
  for c in "${XDG_DATA_HOME:-$HOME/.local/share}/forgejo-cli/keys.json" \
           "$HOME/Library/Application Support/forgejo-cli.forgejo-cli/keys.json" \
           "$HOME/Library/Application Support/forgejo-cli/keys.json"; do
    [[ -f $c ]] && { echo "$c"; return; }
  done
  die "no forgejo-cli keys.json (run: fj auth login, or fj auth add-token)"
}

have() { command -v "$1" >/dev/null; }

origin_url() { git -C "$repo" remote get-url origin; }
url_host() { sed -E 's#^[a-z+]+://([^@/]+@)?([^:/]+).*#\2#; s#^[^@]+@([^:]+):.*#\1#' <<<"$1"; }
url_slug() { sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#' <<<"$1"; }

# Forgejo API call authenticated with fj's stored token for the origin host.
forgejo() {
  local url host keys tok
  keys=$(forgejo_keys)
  url=$(origin_url)
  host=$(jq -r --arg h "$(url_host "$url")" '.aliases[$h] // $h' "$keys")
  tok=$(jq -r --arg h "$host" '.hosts[$h].token // empty' "$keys")
  [[ -n $tok ]] || die "no fj token for $host (run: fj auth login, or fj auth add-token)"
  curl -sf -H "Authorization: token $tok" "https://$host/api/v1/repos/$(url_slug "$url")/$1"
}

# The PR from branch $2 into $1, as {number, state, merged, html_url}, from whichever forge
# hosts origin: gh for github.com, the Forgejo API (fj's token) for any other host.
# Exit 0 found, 1 no such PR, 2 can't check here (no login, no gh, the call failed); the
# reason for 2 goes to stderr.
pr_lookup() {
  local into=$1 branch=$2 url host out
  url=$(origin_url) || { echo "herd: no origin remote" >&2; return 2; }
  host=$(url_host "$url")
  if [[ $host == github.com ]]; then
    have gh || { echo "herd: origin is on github.com and gh is not installed" >&2; return 2; }
    out=$(gh pr list --repo "$(url_slug "$url")" --head "$branch" --base "$into" --state all \
            --json number,state,url --limit 1) \
      || { echo "herd: gh could not list PRs for $(url_slug "$url")" >&2; return 2; }
    [[ $(jq length <<<"$out") -gt 0 ]] || return 1
    jq -c '.[0] | {number, state: (.state | ascii_downcase | if . == "merged" then "closed" else . end),
                   merged: (.state == "MERGED"), html_url: .url}' <<<"$out"
    return 0
  fi
  (forgejo_keys >/dev/null 2>&1) || { echo "herd: no forgejo-cli login to check PRs on $host" >&2; return 2; }
  out=$( (forgejo "pulls/$into/$branch") 2>&1 )
  case $? in
    0) printf '%s\n' "$out" ;;
    *) if [[ $out == *"no fj token"* ]]; then echo "$out" >&2; return 2; fi; return 1 ;;
  esac
}

# Clean up a stream only once its PR is merged: agent idle, worktree clean, then worktree,
# workspace, local and remote branch all go.
cmd_done() {
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  local into=${base#origin/} pr status dirty
  for target in "$@"; do
    find_wt "$target" || continue
    pr=$(pr_lookup "$into" "$branch"); case $? in
      0) ;;
      1) echo "herd: $branch has no PR into $into — not removing (use herd rm to discard)" >&2; continue ;;
      *) echo "herd: can't check $branch's PR — not removing (use herd rm to discard)" >&2; continue ;;
    esac
    if [[ $(jq -r .merged <<<"$pr") != true ]]; then
      echo "herd: $branch PR #$(jq -r .number <<<"$pr") is $(jq -r .state <<<"$pr"), not merged — skipping" >&2
      ((force)) || continue
    fi
    # A PR merged before the agent's last push leaves commits only on this branch.
    git -C "$repo" fetch -q origin "$into"
    local unmerged; unmerged=$(git -C "$path" log --oneline "origin/$into..HEAD")
    if [[ -n $unmerged ]]; then
      echo "herd: $branch has commits not in $into — skipping (open a follow-up PR):" >&2
      sed 's/^/    /' <<<"$unmerged" >&2; ((force)) || continue
    fi
    status=$(h agent list | jq -r --arg p "$path" '.result.agents[] | select(.cwd == $p) | .agent_status' | head -1)
    if [[ $status == working || $status == blocked ]]; then
      echo "herd: agent in $branch is $status — skipping" >&2; ((force)) || continue
    fi
    dirty=$(git -C "$path" status --porcelain)
    if [[ -n $dirty ]]; then
      echo "herd: $branch has uncommitted changes — skipping:" >&2; sed 's/^/    /' <<<"$dirty" >&2
      ((force)) || continue
    fi
    remove_wt
    if git -C "$repo" ls-remote --exit-code --heads origin "$branch" >/dev/null; then
      git -C "$repo" push -q origin --delete "$branch" && echo "deleted origin/$branch"
    fi
    echo "done: PR #$(jq -r .number <<<"$pr") $(jq -r .html_url <<<"$pr")"
  done
}

# Herdr nests a worktree under the workspace it is created from. Prefer the one named after the
# repo, so worktrees don't land under some other workspace (e.g. a K9S one) that happens to sit in
# the repo root.
pick_parent() {
  [[ -n $parent ]] && { echo "$parent"; return; }
  local name ws
  name=$(basename "$repo")
  ws=$(h workspace list | jq -r --arg n "$name" --arg r "$repo" '
    [.result.workspaces[] | select(.label == $n)]
    | (map(select(.worktree.repo_root == $r and (.worktree.is_linked_worktree | not))) + .)
    | .[].workspace_id' | awk '!seen[$0]++')
  for w in $ws; do
    if h pane list --workspace "$w" | jq -e --arg r "$repo" \
        'any(.result.panes[]; .cwd == $r or (.cwd | startswith($r + "/")))' >/dev/null; then
      echo "$w"; return
    fi
  done
  # The current workspace only if it is this repo's: herdr builds the worktree from the parent's
  # repo, so a pane that merely cd'd into another checkout would put the worktree in the wrong one.
  if [[ -n ${HERDR_WORKSPACE_ID:-} && -z $machine ]] \
      && h workspace list | jq -e --arg w "$HERDR_WORKSPACE_ID" --arg r "$repo" \
           'any(.result.workspaces[]; .workspace_id == $w and .worktree.repo_root == $r)' >/dev/null; then
    echo "$HERDR_WORKSPACE_ID"
  fi
}

# A worktree already at $wt_path, left by an earlier start that never got going, is reused when
# there is nothing in it to lose. Anything else is named, with how to remove it, and left alone.
reusable_wt() {
  local branch=$1 why="" cur common
  common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
  if [[ $(git -C "$wt_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) != "$common" ]]; then
    why="it is not a worktree of $repo"
  elif cur=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD) && [[ $cur != "$branch" ]]; then
    why="it is on $cur, not $branch"
  elif [[ -n $(git -C "$wt_path" status --porcelain) ]]; then
    why="it has uncommitted changes"
  elif [[ -n $(git -C "$wt_path" rev-list "$base..HEAD") ]]; then
    why="it has commits not in $base"
  elif h agent list | jq -e --arg p "$wt_path" 'any(.result.agents[]; .cwd == $p)' >/dev/null; then
    why="an agent is already running in it"
  fi
  [[ -z $why ]] && return 0
  die "$wt_path already exists and $why, so herd won't reuse it. Check it, then remove it with:" \
    "herd rm $branch (or: git -C $repo worktree remove $wt_path)"
}

# Creates the branch's worktree and workspace and starts an agent in it, without a prompt.
# Sets wt_name, wt_path and wt_pane.
create_agent() {
  local branch=$1 out
  wt_name=$(agent_name "$branch")
  # shellcheck disable=SC2088  # herdr expands ~ on the remote host
  if [[ -n $machine ]]; then wt_path="~/git/wt/$(basename "$repo")/$wt_name"
  else wt_path="$HOME/git/wt/$(basename "$repo")/$wt_name"; fi

  local src=(--cwd "$repo")
  [[ -n $parent_ws ]] && src=(--workspace "$parent_ws")
  if [[ -z $machine && -e $wt_path ]] && reusable_wt "$branch"; then
    out=$(h worktree open "${src[@]}" --path "$wt_path" --label "$wt_name" --no-focus) \
      || die "worktree open failed for $wt_path"
    echo "herd: reusing $wt_path (clean, on $branch, nothing beyond $base, no agent)" >&2
  else
    out=$(h worktree create "${src[@]}" --branch "$branch" --base "$base" \
            --path "$wt_path" --label "$wt_name" --no-focus) || die "worktree create failed for $branch"
  fi
  wt_pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")

  h agent start "$wt_name" --kind "$kind" --pane "$wt_pane" --timeout 90000 -- "${agent_args[@]}" >/dev/null \
    || die "agent start failed for $wt_name (pane $wt_pane) — inspect with: herdr agent read $wt_name"
}

# Wait only until the turn has visibly started, so a later `agent wait` can't see the pre-prompt idle.
send_prompt() {
  h agent prompt "$1" "$2" --wait --until working --until blocked --until "done" --timeout 30000 >/dev/null \
    || die "prompt not picked up by $1 — inspect with: herdr agent read $1"
}

spawn() {
  local branch=$1 prompt
  prompt=$(compose "$3" "$2")
  create_agent "$branch"
  send_prompt "$wt_name" "$prompt"
  echo "started $wt_name  ($branch -> $wt_path, pane $wt_pane)"
  names+=("$wt_name")
}

# --- herd plan: one plan, run as a chain of stages in one worktree ---------------------------
# State lives in <worktree>/.herd/run/ (git-ignored through info/exclude):
#   plan.md      the plan as given          stages.md  "## Stage N: title" sections
#   PROGRESS.md  the agents' handoff notes  state      stage + status, so -R can resume

# Prints a field of stage $2 from stages file $1: title, verify or body; or, with $2=0, the count.
# The first "verify:" line of a stage is its verify command, and is not part of its body.
stage_field() {
  awk -v want="$2" -v field="${3:-count}" '
    /^## Stage [0-9]+/ {
      n++; skipped = 0
      if (n == want && field == "title") { t = $0; sub(/^## Stage [0-9]+:?[ \t]*/, "", t); print t }
      next
    }
    n != want || n == 0 { next }
    /^verify:/ && !skipped { skipped = 1; if (field == "verify") { v = $0; sub(/^verify:[ \t]*/, "", v); print v }; next }
    field == "body" { print }
    END { if (field == "count") print n + 0 }' "$1"
}

stage_table() {
  local f=$1 n i v
  n=$(stage_field "$f" 0)
  for ((i = 1; i <= n; i++)); do
    v=$(stage_field "$f" "$i" verify)
    printf '%s\t%s\tverify: %s\n' "$i" "$(stage_field "$f" "$i" title)" "${v:-${plan_verify:-(none)}}"
  done | column -t -s $'\t'
}

save_state() {
  printf '%s=%s\n' stage "$stage" status "$status" persona "$persona" kind "$kind" \
    verify "$plan_verify" base "$base" bgwait "$bg_wait" >"$run/state"
}

load_state() {
  local k v
  while IFS='=' read -r k v; do
    case $k in
      stage) stage=$v ;; status) status=$v ;; persona) persona=$v ;; kind) kind=$v ;;
      verify) plan_verify=$v ;; base) base=$v ;; bgwait) bg_wait=$v ;;
    esac
  done <"$run/state"
}

# Waits for the agent's turn to end. Blocked means a human has to answer it, so herd stops there.
await_agent() {
  local s tries=0
  while :; do
    s=$(h agent wait "$wt_name" | jq -r '.result.agent.agent_status') || s="?"
    [[ $s == blocked ]] || break
    # Detection can flash blocked as a turn ends; only a block that is still there 10s later counts.
    sleep 10
    s=$(h agent get "$wt_name" | jq -r '.result.agent.agent_status') || s="?"
    [[ $s == blocked ]] && break
    ((++tries < 5)) || break
  done
  if [[ $s == blocked ]]; then
    # Planning and fix-up keep their status, so -R re-checks the same thing (and spends no extra retry).
    [[ $status != running ]] || { status=blocked; save_state; }
    echo "herd: $wt_name is blocked $(if ((stage)); then echo "in stage $stage"; else echo "while planning"; fi)" \
      "— answer it in its pane, then: herd plan -R $plan_branch" >&2
    return 1
  fi
}

# True if pane text on stdin shows background work still running. Only the last non-blank lines
# count, so the transcript above the prompt box can't match. claude's footer says "1 shell,
# 1 monitor still running" and its status line "· 1 shell, 1 monitor ·"; the "background
# terminal/task/job" forms are a guess at codex, whose footer is not verified.
bg_text_busy() {
  local footer
  footer=$(grep -v '^[[:space:]]*$' | tail -n 10) || true
  grep -Eiq '(^|[^[:alnum:]])[0-9]+ (shells?|monitors?|background (terminals?|tasks?|jobs?))([^[:alnum:]]|$)|·.*still running' \
    <<<"$footer"
}

# True if the agent's pane shows background work running. An unreadable pane counts as not busy;
# the turn rule in the stage prompt still tells the agent not to end a turn on running work.
bg_busy() {
  local txt
  txt=$(h agent read "$wt_name" --source visible 2>/dev/null) || return 1
  bg_text_busy <<<"$txt"
}

# A plan's own stop rule: a line starting "STOPPED:" in PROGRESS.md ends the run at once, with no
# fix-up turn. State keeps its status, so -R re-checks the same stage once the line is gone.
check_stopped() {
  local line
  line=$(grep -m1 '^STOPPED:' "$run/PROGRESS.md" 2>/dev/null) || return 0
  save_state
  echo "herd: stage $stage stopped the run — $line" >&2
  echo "herd: deal with it, delete that line from $run/PROGRESS.md, then: herd plan -R $plan_branch" >&2
  exit 1
}

# Waits for a stage's turn to end, then for any background work the agent is still waiting on (a
# shell or a Monitor it started), so the gate never checks work that is still in flight. When
# that work finishes, the agent wakes, takes another turn, and this waits for that one too. Gives
# up after $bg_wait minutes; that stops the run but is not a failed gate.
await_stage() {
  local start=$SECONDS said=0
  while :; do
    await_agent || exit 3
    check_stopped
    bg_busy || return 0
    if ((SECONDS - start >= bg_wait * 60)); then
      save_state
      echo "herd: stage $stage still has background work running after $bg_wait min — check its pane," \
        "then: herd plan -R $plan_branch (-W sets the wait)" >&2
      exit 3
    fi
    ((said++)) || echo "  stage $stage: turn ended with background work still running, waiting for it"
    sleep "$bg_poll"
  done
}

# Clears the agent's conversation so each stage starts from PROGRESS.md, not a growing context.
fresh_session() {
  local cmd
  case $kind in
    claude) cmd=/clear ;; codex) cmd=/new ;;
    *) echo "herd: no fresh-session command known for '$kind', continuing in the same session" >&2; return ;;
  esac
  h agent prompt "$wt_name" "$cmd" >/dev/null || die "could not clear $wt_name's session"
  sleep 3
}

planner_prompt() {
  cat <<EOF
Split the plan in .herd/run/plan.md into sequential stages. Other agents will execute them one at
a time in this worktree, each in a fresh session that knows only the stage you write and the notes
earlier stages leave in .herd/run/PROGRESS.md. Read the plan and the code it touches first.

Write .herd/run/stages.md in exactly this format, with nothing before the first stage:

## Stage 1: <short title>
verify: <one shell command, run from the worktree root, that exits 0 only when this stage is done>

<the full prompt for this stage, as many lines as it needs>

## Stage 2: <short title>
verify: ...

Use "## Stage" headings only for stages, never inside a prompt. herd adds the handoff, commit and
PR instructions to every stage itself, so leave those out. Change no code and commit nothing; stop
once .herd/run/stages.md is written.
EOF
}

stage_prompt() {
  local v=$1 last=$2 title body
  title=$(stage_field "$run/stages.md" "$stage" title)
  body=$(stage_field "$run/stages.md" "$stage" body)
  cat <<EOF
This is stage $stage of $total of a multi-stage plan, on branch $plan_branch in this worktree.
Earlier stages are committed here already, but you have no memory of them.

Before you start, read .herd/run/PROGRESS.md for what earlier stages did and left for you, and
.herd/run/plan.md if you need the bigger picture. Do only this stage; later stages do the rest.

When you are done:
1. $(if [[ -n $v ]]; then echo "Run \`$v\` from the worktree root and get it passing."; else echo "Run the project's checks and get them passing."; fi)
2. Commit your work with a real message, and leave no uncommitted changes (.herd/run/ is git-ignored).
3. Append a section headed "## Stage $stage: $title" to .herd/run/PROGRESS.md: what you changed,
   the decisions you made, and anything the next stage needs to know.
4. $(if ((last)); then echo "This is the final stage: push the branch and open a PR into ${base#origin/}, with a body that summarises every stage from PROGRESS.md."; else echo "Do not push or open a PR; the final stage does that. Then stop."; fi)

herd checks all of this before it starts the next stage.

herd checks the stage when your turn ends. Never end a turn while a job, Monitor or eval you
started is still running: wait for it in the same turn, then commit and append the
"## Stage $stage" section to .herd/run/PROGRESS.md. If this stage tells you to stop the run, add a
line starting "STOPPED:" with the reason to .herd/run/PROGRESS.md and end your turn.

## Stage $stage: $title

$body
EOF
}

# The last stage's PR check, as a gate line (empty when the PR exists). Where herd can't check
# (no gh, no fj login, the call failed) it is skipped with a note on stderr, not failed.
stage_pr_msg() {
  local into=${base#origin/} err rc
  err=$(pr_lookup "$into" "$plan_branch" 2>&1 >/dev/null); rc=$?
  case $rc in
    1) printf -- '- There is no PR from %s into %s.' "$plan_branch" "$into" ;;
    2) echo "  could not check the PR, so not gating on it: $err" >&2 ;;
  esac
}

# Checks that stage $stage is really finished. Sets gate_msg to what is missing.
stage_gate() {
  local v=$1 last=$2 out dirty head remote
  gate_msg=""
  grep -Eq "^## Stage $stage([^0-9]|$)" "$run/PROGRESS.md" 2>/dev/null \
    || gate_msg+="- .herd/run/PROGRESS.md has no \"## Stage $stage\" section."$'\n'
  dirty=$(git -C "$wt_path" status --porcelain)
  [[ -z $dirty ]] || gate_msg+="- There are uncommitted changes:"$'\n'"$dirty"$'\n'
  if [[ -n $v ]]; then
    echo "  verify: $v"
    out=$(cd "$wt_path" && bash -c "$v" 2>&1) \
      || gate_msg+="- \`$v\` failed. The end of its output:"$'\n'"$(tail -40 <<<"$out")"$'\n'
  fi
  if ((last)); then
    head=$(git -C "$wt_path" rev-parse HEAD)
    remote=$(git -C "$wt_path" ls-remote origin "refs/heads/$plan_branch" | cut -f1)
    [[ $head == "$remote" ]] || gate_msg+="- The branch is not pushed to origin at HEAD."$'\n'
    out=$(stage_pr_msg); [[ -z $out ]] || gate_msg+="$out"$'\n'
  fi
  [[ -z $gate_msg ]]
}

planner_gate() {
  gate_msg=""
  if [[ ! -s $run/stages.md ]]; then gate_msg="- .herd/run/stages.md does not exist or is empty."
  elif [[ $(stage_field "$run/stages.md" 0) -eq 0 ]]; then gate_msg="- .herd/run/stages.md has no \"## Stage N: title\" headings."
  fi
  [[ -z $gate_msg ]]
}

# Runs the plan from wherever its state says it is. Every step saves state first, so an
# interrupt, a blocked agent or a failed gate can all be picked up with -R.
drive_plan() {
  local v last
  if [[ $status == planning || $status == replanning ]]; then
    await_agent || exit 3
    if ! planner_gate; then
      [[ $status == planning ]] || { status=failed; save_state; die "planner did not write usable stages:"$'\n'"$gate_msg"; }
      status=replanning; save_state
      send_prompt "$wt_name" "herd could not use your stages file:"$'\n'"$gate_msg"$'\n'"Write it in the format you were given, then stop."
      drive_plan; return
    fi
    stage=1 status=pending; save_state
    echo "planned $(stage_field "$run/stages.md" 0) stage(s):"; stage_table "$run/stages.md" | sed 's/^/  /'
    if ((dry)); then echo "stopping before stage 1 (-n); edit $run/stages.md if you like, then: herd plan -R $plan_branch"; exit; fi
  fi

  total=$(stage_field "$run/stages.md" 0)
  while ((stage <= total)); do
    v=$(stage_field "$run/stages.md" "$stage" verify); v=${v:-$plan_verify}
    last=$((stage == total))
    case $status in
      verified) stage=$((stage + 1)) status=pending; save_state; continue ;;
      pending)
        fresh_session
        status=running; save_state
        send_prompt "$wt_name" "$(compose "$persona" "$(stage_prompt "$v" "$last")")"
        echo "stage $stage/$total: $(stage_field "$run/stages.md" "$stage" title)" ;;
    esac
    # running, fixing, blocked or failed: let the turn and its background work end, then check.
    await_stage
    if stage_gate "$v" "$last"; then
      status=verified; save_state; echo "  stage $stage verified"; continue
    fi
    # The gate can take a while. If the agent started more background work meanwhile, wait again
    # rather than send (or count) a fix-up turn against work still in flight.
    if bg_busy; then continue; fi
    if [[ $status == fixing ]]; then
      status=failed; save_state
      echo "herd: stage $stage still fails after a fix-up turn:" >&2; sed 's/^/    /' <<<"$gate_msg" >&2
      echo "herd: fix it in the pane (or edit $run/stages.md), then: herd plan -R $plan_branch" >&2
      exit 1
    fi
    echo "  stage $stage not done yet, sending a fix-up turn:"; sed 's/^/    /' <<<"$gate_msg"
    status=fixing; save_state
    send_prompt "$wt_name" "Stage $stage of $total is not done yet. herd checked and found:"$'\n\n'"$gate_msg"$'\n'"Fix these, then make sure the \"## Stage $stage\" section of .herd/run/PROGRESS.md is up to date, and stop. Don't end the turn while a job, Monitor or eval you started is still running."
  done
  status=complete; save_state
  echo "plan complete: $total stage(s) on $plan_branch. After the PR merges: herd done $plan_branch"
}

cmd_plan() {
  [[ -z $machine ]] || die "plan runs its checks in the worktree, so it works on this machine only (no -m)"
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  repo=$(cd "$repo" && git rev-parse --show-toplevel)
  local text staged=0 tmp
  if ((resume)); then
    find_wt "$plan_branch" || exit 1
    wt_name=$(agent_name "$plan_branch") wt_path=$path run="$path/.herd/run"
    [[ -f $run/state ]] || die "no plan run in $path"
    load_state
    bg_wait=${bg_wait_opt:-$bg_wait}   # -W on a resume overrides the saved wait
    [[ $status != complete ]] || { echo "plan on $plan_branch is already complete"; return; }
    echo "resuming $plan_branch at stage $stage ($status)"
    drive_plan; return
  fi

  if [[ $plan_src == - ]]; then text=$(cat)
  elif [[ -f $plan_src ]]; then text=$(cat "$plan_src")
  else text=$plan_src; fi
  [[ -n ${text//[[:space:]]/} ]] || die "the plan is empty"
  grep -Eq '^## Stage [0-9]+' <<<"$text" && staged=1
  persona=${persona:-engineer}
  [[ $persona == none ]] || persona_file "$persona" >/dev/null
  ((staged)) || persona_file planner >/dev/null

  if ((staged && dry)); then
    tmp=$(mktemp); printf '%s\n' "$text" >"$tmp"
    echo "$plan_branch ($(agent_name "$plan_branch")), persona $persona, $(stage_field "$tmp" 0) stage(s):"
    stage_table "$tmp" | sed 's/^/  /'; rm -f "$tmp"; return
  fi

  [[ $base == origin/* ]] && git -C "$repo" fetch -q origin "${base#origin/}"
  parent_ws=$(pick_parent)
  create_agent "$plan_branch"
  run="$wt_path/.herd/run"
  mkdir -p "$run"
  local exclude; exclude="$(git -C "$wt_path" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.herd/run/' "$exclude" 2>/dev/null || echo '.herd/run/' >>"$exclude"
  printf '%s\n' "$text" >"$run/plan.md"
  echo "started $wt_name  ($plan_branch -> $wt_path, pane $wt_pane)"

  if ((staged)); then
    cp "$run/plan.md" "$run/stages.md"
    stage=1 status=pending; save_state
    echo "plan has $(stage_field "$run/stages.md" 0) stage(s) already, skipping the planner"
  else
    stage=0 status=planning; save_state
    send_prompt "$wt_name" "$(compose planner "$(planner_prompt)")"
    echo "planning: the planner is splitting the plan into stages"
  fi
  drive_plan
}

# Sourced (by tests/plan.sh): define the functions above, run nothing.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

# --- herd draft: a goal in, a task file out ----------------------------------------------------
# A dispatcher agent reads the repo (read-only tools, headless, in the repo root) and writes the
# task file; herd checks every line the way a run would before it saves anything.

# Personas a task line can name, as "- name: summary". Leaves out the ones herd runs itself, and
# names a "@persona" can't spell.
task_personas() {
  local d f
  while IFS= read -r d; do
    [[ -d $d ]] || continue
    for f in "$d"/*.md; do
      [[ -f $f ]] || continue
      printf '%s\t%s\n' "$(basename "$f" .md)" "$(sed -n 's/^> //p' "$f" | head -1)"
    done
  done < <(persona_dirs) | awk -F'\t' '
    !seen[$1]++ && $1 ~ /^[A-Za-z0-9._-]+$/ && $1 != "planner" && $1 != "dispatcher" {
      d = $2 == "" ? "(no summary)" : $2; if (length(d) > 140) d = substr(d, 1, 137) "..."
      print "  - " $1 ": " d }'
}

draft_prompt() {
  cat <<EOF
Turn the goal below into a herd task file for this repository. Read the code the goal touches
first, then write the file.

Each task line starts one agent, in its own fresh worktree cut from $base, all at the same time:

<branch> @<persona>: <prompt>

- <branch> is a new git branch with a type prefix (fix/, feat/, docs/, chore/, ...), short and
  unique; it also names the agent, cut to 32 characters.
- @<persona> is one of:
$(task_personas)
- <prompt> is the whole task on ONE line, however long. Only the first ":" splits the line, so
  the prompt may contain colons.
- Put a "# " comment line above each task saying what it is for. If the goal is one change whose
  parts must happen in order, write a single task and say in its comment that "herd plan" fits
  it better.

Reply with the file's contents only: no code fences, no preamble, nothing after the last task.
Change no files.

# Goal

$1
EOF
}

# Checks task file $1 the way a run would, plus what a run would trip over later: a bad branch
# name, one that already exists, or two tasks with the same agent name. Every line must name its
# persona, which also keeps a stray "Sure: here it is" from passing as a task. Sets gate_msg.
check_task_file() {
  local line key prompt n=0 seen=" " an
  gate_msg=""
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    key=${line%%:*}
    if [[ $line != *:* || ! $key =~ ^[[:space:]]*[^[:space:]@]+[[:space:]]+@[A-Za-z0-9._/-]+[[:space:]]*$ ]]; then
      gate_msg+="- not a \"<branch> @<persona>: <prompt>\" line: ${line:0:100}"$'\n'; continue
    fi
    n=$((n + 1))
    split_key "$key"
    prompt=$(sed 's/^[[:space:]]*//' <<<"${line#*:}")
    [[ -n $prompt ]] || gate_msg+="- $task_branch has an empty prompt"$'\n'
    git check-ref-format --branch "$task_branch" >/dev/null 2>&1 \
      || gate_msg+="- $task_branch is not a valid branch name"$'\n'
    if git -C "$repo" show-ref --quiet --verify "refs/heads/$task_branch" \
        || git -C "$repo" show-ref --quiet --verify "refs/remotes/origin/$task_branch"; then
      gate_msg+="- branch $task_branch already exists, pick another name"$'\n'
    fi
    an=$(agent_name "$task_branch")
    [[ $seen != *" $an "* ]] || gate_msg+="- $task_branch gives agent name $an, which another task already has"$'\n'
    seen+="$an "
    if [[ -n $task_persona && $task_persona != none ]] && ! (persona_file "$task_persona" >/dev/null 2>&1); then
      gate_msg+="- $task_branch names an unknown persona @$task_persona"$'\n'
    fi
  done <"$1"
  ((n)) || gate_msg+="- there are no task lines"$'\n'
  [[ -z $gate_msg ]]
}

# One headless dispatcher turn; the first starts session $sid, later ones resume it.
draft_turn() {
  local args=(-p "--tools=Read,Grep,Glob" --output-format text)
  if ((turns++)); then args+=(--resume "$sid"); else args+=(--session-id "$sid"); fi
  (cd "$repo" && claude "${args[@]}" "${agent_args[@]}" <<<"$1") | sed '/^[[:space:]]*```/d'
}

cmd_draft() {
  [[ -z $machine ]] || die "draft runs on this machine only (no -m)"
  [[ $kind == claude ]] || die "draft runs claude headless; -k $kind is not supported"
  command -v claude >/dev/null || die "draft needs the claude CLI on PATH"
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  repo=$(cd "$repo" && git rev-parse --show-toplevel)
  local text tmp sid turns=0
  if [[ $draft_src == - ]]; then text=$(cat)
  elif [[ -f $draft_src ]]; then text=$(cat "$draft_src")
  else text=$draft_src; fi
  [[ -n ${text//[[:space:]]/} ]] || die "the goal is empty"
  out=${out:-$repo/Tasks.herd}
  if [[ $out != - && -e $out ]] && ! ((force)); then
    if [[ $out == "$repo/Tasks.herd" ]]; then
      die "$out already exists: name another with -o Tasks-<name>.herd, or -F to overwrite it"
    fi
    die "$out already exists (-F overwrites it)"
  fi
  persona_file dispatcher >/dev/null

  sid=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid) || die "could not make a session id"
  tmp=$(mktemp "${TMPDIR:-/tmp}/herd-draft.XXXXXX")
  echo "herd: drafting tasks in $repo (read-only, this takes a minute or two)" >&2
  draft_turn "$(compose dispatcher "$(draft_prompt "$text")")" >"$tmp" || die "claude failed (output so far: $tmp)"
  if ! check_task_file "$tmp"; then
    echo "herd: the draft has problems, asking for one fix:" >&2; sed 's/^/    /' <<<"${gate_msg%$'\n'}" >&2
    draft_turn "herd could not use that task file:"$'\n'"$gate_msg"$'\n'"Reply with the whole corrected file, in the same format, and nothing else." >"$tmp" \
      || die "claude failed (output so far: $tmp)"
    check_task_file "$tmp" || { sed 's/^/    /' <<<"${gate_msg%$'\n'}" >&2; die "the draft still has problems, left in $tmp"; }
  fi

  if [[ $out == - ]]; then cat "$tmp"; rm -f "$tmp"; return; fi
  { printf '# Drafted by herd draft on %s from:\n' "$(date +%F)"
    sed 's/^/#   /' <<<"$text" | head -20
    echo; cat "$tmp"; } >"$out"
  rm -f "$tmp"
  echo "wrote $out:" >&2
  "${BASH_SOURCE[0]}" -n -r "$repo" -f "$out" | sed 's/^/  /' >&2
  if [[ $out == "$repo/Tasks.herd" ]]; then echo "review it, then start it with: herd" >&2
  else echo "review it, then start it with: herd -f $out" >&2; fi
}

case ${1:-} in
  ls) shift; cmd_ls; exit ;;
  personas) shift; [[ $# -le 1 ]] || die "personas takes at most one name"
      repo=$(git rev-parse --show-toplevel 2>/dev/null || true); cmd_personas "$@"; exit ;;
  "done") shift; while getopts "r:b:Ff:" o; do case $o in r) repo=$OPTARG;; b) base=$OPTARG;; F) force=1;; f) file=$OPTARG;; *) exit 2;; esac; done
      shift $((OPTIND-1)); targets=("$@"); [[ -n $file || $# -gt 0 ]] || file=$(default_file)
      [[ -z $file ]] || read_targets "$file"
      [[ ${#targets[@]} -gt 0 ]] || die "done needs a branch or agent name (or -f file, or a Tasks.herd)"; cmd_done "${targets[@]}"; exit ;;
  plan) shift; resume=0 plan_verify="" bg_wait_opt=""
      while getopts "r:b:k:m:p:P:v:W:nRh" o; do case $o in
        r) repo=$OPTARG;; b) base=$OPTARG;; k) kind=$OPTARG;; m) machine=$OPTARG;; p) parent=$OPTARG;;
        P) persona=$OPTARG;; v) plan_verify=$OPTARG;; W) bg_wait_opt=$OPTARG;; n) dry=1;; R) resume=1;;
        h) usage; exit;; *) exit 2;; esac; done
      [[ -z $bg_wait_opt || $bg_wait_opt =~ ^[0-9]+$ ]] || die "-W takes whole minutes, not '$bg_wait_opt'"
      bg_wait=${bg_wait_opt:-$bg_wait}
      shift $((OPTIND-1)); plan_branch=$(tr -d '[:space:]' <<<"${1:-}")
      [[ -n $plan_branch ]] || die "plan needs a branch: herd plan <branch> <plan.md|-|text>, or herd plan -R <branch>"
      shift
      if ((resume)); then [[ $# -eq 0 ]] || die "plan -R takes only the branch"
      else
        [[ $# -ge 1 && $1 != "--" ]] || die "plan needs a plan: a file, - for stdin, or the text itself"
        plan_src=$1; shift
        [[ ${1:-} != "--" ]] || { shift; agent_args=("$@"); set --; }
        [[ $# -eq 0 ]] || die "plan takes one branch and one plan"
      fi
      cmd_plan; exit ;;
  draft) shift; out=""
      while getopts "r:b:k:o:Fh" o; do case $o in
        r) repo=$OPTARG;; b) base=$OPTARG;; k) kind=$OPTARG;; o) out=$OPTARG;; F) force=1;; h) usage; exit;; *) exit 2;; esac; done
      shift $((OPTIND-1))
      [[ $# -ge 1 && $1 != "--" ]] || die "draft needs a goal: the text itself, a file, or - for stdin"
      draft_src=$1; shift
      [[ ${1:-} != "--" ]] || { shift; agent_args=("$@"); set --; }
      [[ $# -eq 0 ]] || die "draft takes one goal (quote it)"
      cmd_draft; exit ;;
  rm) shift; while getopts "r:m:f:" o; do case $o in r) repo=$OPTARG;; m) machine=$OPTARG;; f) file=$OPTARG;; *) exit 2;; esac; done
      shift $((OPTIND-1)); targets=("$@"); [[ -z $file ]] || read_targets "$file"
      [[ ${#targets[@]} -gt 0 ]] || die "rm needs a branch or agent name (or -f file)"; cmd_rm "${targets[@]}"; exit ;;
esac

while getopts "r:b:k:m:p:P:f:wnh" o; do
  case $o in
    r) repo=$OPTARG ;; b) base=$OPTARG ;; k) kind=$OPTARG ;; m) machine=$OPTARG ;;
    p) parent=$OPTARG ;; P) persona=$OPTARG ;; f) file=$OPTARG ;; w) wait=1 ;; n) dry=1 ;;
    h) usage; exit ;; *) exit 2 ;;
  esac
done
# getopts eats a bare -- as its end-of-options marker. Put it back, so `herd [opts] -- <args>`
# passes <args> to the agent instead of reading them as <branch> <prompt> pairs.
((OPTIND > 1)) && [[ ${*:OPTIND-1:1} == "--" ]] && OPTIND=$((OPTIND - 1))
shift $((OPTIND-1))

tasks=()
while [[ $# -gt 0 && $1 != "--" ]]; do
  [[ $# -ge 2 ]] || die "expected <branch> <prompt> pairs"
  split_key "$1"; tasks+=("$task_branch" "$2" "$task_persona"); shift 2
done
[[ ${1:-} == "--" ]] && { shift; agent_args=("$@"); }

[[ -n $file || ${#tasks[@]} -gt 0 ]] || file=$(default_file)
if [[ -n $file ]]; then
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line == *:* ]] || die "bad line (want 'branch: prompt'): $line"
    split_key "${line%%:*}"
    tasks+=("$task_branch" "$(sed 's/^[[:space:]]*//' <<<"${line#*:}")" "$task_persona")
  done <"$file"
fi
[[ ${#tasks[@]} -gt 0 ]] || { usage; exit 2; }

if [[ -z $machine ]]; then
  [[ -n $repo ]] || repo=$(git rev-parse --show-toplevel)
  repo=$(cd "$repo" && git rev-parse --show-toplevel)
  [[ $base == origin/* && $dry -eq 0 ]] && git -C "$repo" fetch -q origin "${base#origin/}"
else
  [[ -n $repo ]] || die "-m needs -r <remote repo path>"
fi

# Resolve every persona before spawning anything, so a typo can't leave a half-run fan-out.
for ((i = 2; i < ${#tasks[@]}; i += 3)); do
  [[ -z ${tasks[i]} || ${tasks[i]} == none ]] || persona_file "${tasks[i]}" >/dev/null
done

if ((dry)); then
  for ((i = 0; i < ${#tasks[@]}; i += 3)); do
    printf '%s\t%s\t%s\t%s\n' "${tasks[i]}" "$(agent_name "${tasks[i]}")" "${tasks[i+2]:-none}" \
      "$(head -c 60 <<<"${tasks[i+1]}")..."
  done | column -t -s $'\t'
  exit
fi

parent_ws=$(pick_parent)
[[ -n $parent_ws ]] && echo "grouping under workspace $parent_ws"
names=()
for ((i = 0; i < ${#tasks[@]}; i += 3)); do spawn "${tasks[i]}" "${tasks[i+1]}" "${tasks[i+2]}"; done

if ((wait)); then
  echo "waiting for ${#names[@]} agent(s)..."
  for n in "${names[@]}"; do
    s=$(h agent wait "$n" 2>/dev/null | jq -r '.result.agent.agent_status' || echo "?")
    echo "  $n: $s"
  done
fi
